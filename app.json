{
  "expo": {
    "name": "safe-signal",
    "slug": "safe-signal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "O SafeSignal usa suas fotos para definir a imagem de perfil.",
          "cameraPermission": "O SafeSignal usa a câmera para tirar sua foto de perfil."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "O SafeSignal usa sua agenda para marcar check-ups de saúde."
        }
      ]
    ]
  }
}
